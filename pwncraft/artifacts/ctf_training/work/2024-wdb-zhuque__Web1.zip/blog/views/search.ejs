<html>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@0.9.4/css/bulma.min.css" />
    <link href="https://unpkg.com/nes.css@latest/css/nes.min.css" rel="stylesheet" />
    <link rel="shortcut icon" href="/assets/img/48x48M.png" />
    <style>
        body {
            background-image: url('/assets/img/backgroud.png');
            background-attachment: fixed;
            background-position: center;
            background-repeat: no-repeat;
            background-size: cover;
        }
    </style>
    <title>Home</title>
</head>
<body>
<div class="mb-4">
    <nav class="navbar" role="navigation" aria-label="main navigation" style="background-color:#2e0428;">
        <div class="navbar-menu is-active" id="nav-menu" style="background-color:rgba(68, 4, 68, 0.315);">
            <div class="navbar-start">
                <a class="navbar-item" style="background-color:rgba(224, 54, 224, 0.315);" href="/">
              <span class="icon is-medium">
                <img src="/assets/img/home.png" />
              </span>
                    <span style="color:white;"> Home</span>
                </a>
                <a class="navbar-item" style="background-color:rgba(68, 4, 68, 0.315);" href="/search?username=test">
              <span class="icon is-medium">
                <img src="/assets/img/search.png" />
              </span>
                    <span style="color:white;">Search</span>
                </a>
            </div>
            <%_ if (user) { _%>
            <div class="navbar-end">
                <a class="navbar-item" style="background-color:rgba(68, 4, 68, 0.315);" href="/dologout">
              <span class="icon is-medium">
                <img src="/assets/img/out.png" />
              </span>
                    <span style="color:white;"> Log out</span>
                </a>
            </div>
            <%_ } _%>
        </div>
    </nav>
</div>
<div class="container has-text-centered">
    <div class="column is-8 is-offset-2">
        <%_ if (user) { _%>
            <div class="box">
                <div class="nes-container with-title is-centered my-4">
                    <p class="title">Search</p>
                    <p class="is-size-4 has-text-left">Welcome to the search page, <%= user.user %>!</p>
                    <p class="is-size-5 has-text-weight-bold has-text-left">Post List :</p>
                    <div class="content">

                        <ul id="post-list"></ul>
                    </div>
                </div>
            </div>
        <%_ } else { _%>
        <div class="box">
            <div class="nes-container with-title is-centered my-4">
                <p class="title">Welcome</p>
                <p>Login or create an account to continue</p>
                <a href="/login" class="button is-primary">Login</a>
                <a href="/register" class="button is-danger">Register</a>
            </div>
        </div>
        <%_ } _%>
    </div>
</div>
<script>
    <%_ if (locals.POST_SERVER) { /* posts are stored on a different page */ _%>
    const POST_SERVER = "<%= POST_SERVER %>";
    <%_ } else { /* post server is on the same origin */ _%>
    const POST_SERVER = "";
    <%_ } _%>

    const $ = document.querySelector.bind(document); // imagine using jQuery...

    function load_post(data) {
        var postList = $('#post-list');
        if (!data.success) {
            const newPost = document.createElement('li');
            newPost.classList.add('has-text-left');
            const postLink = document.createElement('a');
            postLink.textContent = data.error;
            newPost.appendChild(postLink);
            postList.appendChild(newPost);
            return;
        }

        data.list.forEach(function(post) {
            const newPost = document.createElement('li');
            newPost.classList.add('has-text-left');
            const postLink = document.createElement('a');
            postLink.href = '/post/?id='+post;
            postLink.textContent = post;
            newPost.appendChild(postLink);
            postList.appendChild(newPost);
        });

    }

    window.onload = function() {
        const username = new URLSearchParams(window.location.search).get('username');
        let uri=`/dosearch`;
        if(username)
        {
            uri+=(`/username/`+encodeURIComponent(username));
        }
        // Load post from POST_SERVER
        const request = new XMLHttpRequest();
        request.open('GET', POST_SERVER + uri, false);
        request.send(null);

        load_post(JSON.parse(request.responseText));
    }
</script>

</body>
</html>