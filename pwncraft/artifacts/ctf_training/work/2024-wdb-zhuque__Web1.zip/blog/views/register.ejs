<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@0.9.4/css/bulma.min.css" />
    <link href="https://unpkg.com/nes.css@latest/css/nes.min.css" rel="stylesheet" />
    <link rel="shortcut icon" href="/assets/img/48x48M.png" />
    <style>
      body {
        background-image: url('/assets/img/backgroud.png');
        background-attachment: fixed;
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
      }
    </style>
    <title>Register</title>
  </head>
  <body>
    <div class="mb-4">
      <nav class="navbar" role="navigation" aria-label="main navigation" style="background-color:#2e0428;">
        <div class="navbar-menu is-active" id="nav-menu" style="background-color:rgba(68, 4, 68, 0.315);">
          <div class="navbar-start">
            <a class="navbar-item" style="background-color:rgba(224, 54, 224, 0.315);" href="/">
              <span class="icon is-medium">
                <img src="/assets/img/home.png" />
              </span>
              <span style="color:white;"> Home</span>
            </a>
            <a class="navbar-item" style="background-color:rgba(68, 4, 68, 0.315);" href="/search?username=test">
              <span class="icon is-medium">
                <img src="/assets/img/search.png" />
              </span>
              <span style="color:white;">Search</span>
            </a>
          </div>
          <%_ if (user) { _%>
          <div class="navbar-end">
            <a class="navbar-item" style="background-color:rgba(68, 4, 68, 0.315);" href="/dologout">
              <span class="icon is-medium">
                <img src="/assets/img/out.png" />
              </span>
              <span style="color:white;"> Log out</span>
            </a>
          </div>
          <%_ } _%>
        </div>
      </nav>
    </div>
    <div class="container has-text-centered">
      <div class="column is-8 is-offset-2">
        <div class="box">
          <div class="nes-container with-title my-4 is-centered">
            <p class="title">Register</p>
            <form method="POST" action="/doregister">
              <div class="field">
                <label class="label is-pulled-left">Username</label>
                <div class="control">
                  <input class="input" type="text" placeholder="Username" name="user" />
                </div>
              </div>
              <div class="field">
                <label class="label is-pulled-left">Password</label>
                <div class="control">
                  <input class="input" type="password" placeholder="Password" name="pass" />
                </div>
              </div>
              <div class="field">
                <div class="control">
                  <button class="button is-link" type="submit">Register</button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
    <script>
      window.onload = function() {
        const msg = new URLSearchParams(window.location.search).get('msg');
        if (!msg) {
          return;
        }

        alert(msg);
        history.replaceState(null, document.title, location.pathname);
      }
    </script>
  </body>
</html>